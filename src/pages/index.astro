---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base title="William Heyden">
  <section>
    <div class="hero">
      <img class="avatar" src="/avatar.jpg" alt="William Heyden" width="84" height="84" />
      <div>
        <h1>William Heyden</h1>
        <p class="lede">Computer Vision Researcher &middot; PhD Candidate</p>
      </div>
    </div>

    <p>
      I'm a final-year PhD candidate in Artificial Intelligence and Machine
      Learning at the Norwegian University of Life Sciences (NMBU), Ås,
      Norway, researching computer vision with a focus on zero-shot
      classification — building practical methods that let models recognize
      novel categories without task-specific labeled data. My work sits at
      the intersection of representation learning and open-vocabulary
      recognition — I care about approaches that hold up outside the
      benchmark, not just on it.
    </p>
    <p>
      As I finish my PhD, I'm looking for research-engineering roles where I
      can take methods from paper to production: applied research, ML
      research engineering, or applied scientist positions working on vision
      or multimodal systems.
    </p>

    <ul class="actions">
      <li><a class="primary" href="mailto:william@heyden.no">Email</a></li>
      <li><a href="https://github.com/william-heyden" target="_blank" rel="noopener">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/heyden-william/" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="https://scholar.google.com/citations?user=yx3uyQUAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a></li>
    </ul>
  </section>

  <section>
    <h2>Featured work</h2>
    {projects.length === 0 && (
      <p class="empty">
        No projects published yet — add entries under
        <code>src/content/projects/</code> and they'll appear here.
      </p>
    )}
    <ul class="plain">
      {projects.map((project) => (
        <li class="card">
          <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
          <p class="meta">
            {project.data.type === 'paper'
              ? `${project.data.venue}${project.data.year ? `, ${project.data.year}` : ''}`
              : project.data.status}
          </p>
          <p>{project.data.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
