---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('projects', ({ data }) => data.type === 'paper')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);
---

<Base title="CV" description="CV of William Heyden — computer vision researcher, PhD candidate at NMBU.">
  <h1>CV</h1>
  <p class="lede">Computer Vision Researcher &middot; PhD Candidate &middot; Oslo, Norway</p>

  <section>
    <h2>Education</h2>
    <div class="card">
      <h3>PhD, Artificial Intelligence and Machine Learning</h3>
      <p class="meta">Norwegian University of Life Sciences (NMBU), Ås, Norway &middot; 2022–2026 (expected)</p>
      <p>
        PhD candidate at the Data Science Institute, researching AI learning
        algorithms for more sustainable applications, with a dissertation
        focus on zero-shot classification.
      </p>
    </div>
    <div class="card">
      <h3>MSc, Business Intelligence and Analytics</h3>
      <p class="meta">University of Westminster, London, UK &middot; 2018–2019</p>
      <p>Electives in Machine Learning and Optimisation techniques. Thesis: "Causal Discovery Algorithms".</p>
    </div>
    <div class="card">
      <h3>BSc, International Business</h3>
      <p class="meta">Grenoble Ecole de Management, Grenoble, France &middot; 2015–2018</p>
      <p>
        Minor in Finance, graduated with Distinction. Exchange semester at
        Hanken School of Economics, Helsinki, Finland (Aug–Dec 2017),
        with electives in Economic Science and Financial Analysis and
        Valuation.
      </p>
    </div>
  </section>

  <section>
    <h2>Research focus</h2>
    <ul>
      <li>Zero-shot and generalized zero-shot image classification</li>
      <li>Semantic representation learning for vision</li>
      <li>Generative and closed-form approaches to classifier extension</li>
    </ul>
  </section>

  <section>
    <h2>Publications</h2>
    {papers.length === 0 && (
      <p class="empty">
        Add publications here — title, venue, year, and a link to the paper.
      </p>
    )}
    <ul class="plain">
      {papers.map((paper) => (
        <li class="card">
          <h3><a href={`/projects/${paper.id}/`}>{paper.data.title}</a></h3>
          <p class="meta">
            {paper.data.venue}{paper.data.year ? `, ${paper.data.year}` : ''}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Experience</h2>
    <div class="card">
      <h3>Teaching</h3>
      <p class="meta">Norwegian University of Life Sciences (NMBU), Ås, Norway &middot; 2022–present</p>
      <ul>
        <li>Course leader, DAT200: Applied Machine Learning</li>
        <li>Teaching assistant, DAT300: Applied Deep Learning</li>
        <li>Teaching assistant, INF221: Computer Science for Data Scientists</li>
      </ul>
    </div>
    <div class="card">
      <h3>Data Scientist Consultant — Knowit AS</h3>
      <p class="meta">Oslo, Norway &middot; 2020–2022</p>
      <ul>
        <li>Designed and built a data platform in Azure for NHO (Confederation of Norwegian Enterprise)</li>
        <li>Developed data models for prediction and insight for Electrolux</li>
        <li>AM/AO responsible in a SAS environment for a private bank</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Skills</h2>
    <ul>
      <li><strong>Coding:</strong> Advanced in Python (incl. PyTorch and TensorFlow); working knowledge of R, MATLAB, DAX, and SQL</li>
      <li><strong>Certifications:</strong> Azure Solution Architect — advising stakeholders and translating business requirements into cloud solutions</li>
      <li><strong>Languages:</strong> Norwegian (native), English (fluent), German (basic), French (basic)</li>
    </ul>
  </section>
</Base>
