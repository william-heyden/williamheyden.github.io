---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('projects', ({ data }) => data.type === 'paper')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);
---

<Base title="CV" description="CV of William Heyden — computer vision researcher, PhD candidate.">
  <h1>CV</h1>
  <p class="lede">Computer Vision Researcher &middot; PhD Candidate</p>
  <ul class="actions">
    <li><a class="primary" href="/resume.pdf" target="_blank" rel="noopener">Download PDF</a></li>
    <!-- TODO: add a resume.pdf file to /public and this link will work as-is. -->
  </ul>

  <section>
    <h2>Education</h2>
    <div class="card">
      <h3>PhD, Computer Vision <!-- TODO: institution name --></h3>
      <p class="meta">Expected 2027 &middot; <!-- TODO: location --></p>
      <p>
        Dissertation focus: zero-shot classification — methods for
        recognizing novel visual categories without task-specific labeled
        examples.
        <!-- TODO: add advisor name, thesis title once finalized. -->
      </p>
    </div>
  </section>

  <section>
    <h2>Research focus</h2>
    <ul>
      <li>Zero-shot and open-vocabulary image classification</li>
      <li>Vision-language representation learning</li>
      <li>Generalization to novel categories and distribution shift</li>
      <!-- TODO: refine to your actual sub-areas. -->
    </ul>
  </section>

  <section>
    <h2>Publications</h2>
    {papers.length === 0 && (
      <p class="empty">
        Add publications here — title, venue, year, and a link to the paper.
      </p>
    )}
    <ul class="plain">
      {papers.map((paper) => (
        <li class="card">
          <h3><a href={`/projects/${paper.id}/`}>{paper.data.title}</a></h3>
          <p class="meta">
            {paper.data.venue}{paper.data.year ? `, ${paper.data.year}` : ''}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Experience</h2>
    <p class="empty">
      Add research/industry experience here — role, organization, dates, and
      1-2 impact-focused bullet points per entry.
    </p>
  </section>

  <section>
    <h2>Skills</h2>
    <ul>
      <li><strong>Languages:</strong> Python <!-- TODO: add others --></li>
      <li><strong>ML/CV:</strong> PyTorch <!-- TODO: add frameworks (e.g. timm, open_clip, JAX) --></li>
      <li><strong>Tooling:</strong> <!-- TODO: e.g. Docker, Slurm, W&B --></li>
    </ul>
  </section>
</Base>
