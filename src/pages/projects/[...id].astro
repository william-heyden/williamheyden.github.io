---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project, all: projects },
  }));
}

const { project, all } = Astro.props;
const { Content } = await render(project);
const isPaper = project.data.type === 'paper';
const basedOnPapers = (project.data.basedOn ?? [])
  .map((id) => all.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---

<Base title={project.data.title} description={project.data.summary}>
  <h1>{project.data.title}</h1>

  {isPaper ? (
    <>
      <p class="meta">
        {project.data.venue}{project.data.year ? `, ${project.data.year}` : ''}
      </p>
      {project.data.authors && <p class="meta">{project.data.authors}</p>}
    </>
  ) : (
    <p class="meta">{project.data.status}</p>
  )}

  {basedOnPapers.length > 0 && (
    <p class="based-on">
      Based on{' '}
      {basedOnPapers.map((paper, i) => (
        <>
          {i > 0 && ', '}
          <a href={`/projects/${paper!.id}/`}>{paper!.data.title}</a>
        </>
      ))}
    </p>
  )}

  {project.data.links && (
    <ul class="actions">
      {project.data.links.paper && (
        <li><a class="primary" href={project.data.links.paper} target="_blank" rel="noopener">Read the paper</a></li>
      )}
      {project.data.links.arxiv && (
        <li><a href={project.data.links.arxiv} target="_blank" rel="noopener">arXiv</a></li>
      )}
      {project.data.links.github && (
        <li><a href={project.data.links.github} target="_blank" rel="noopener">Code</a></li>
      )}
      {project.data.links.demo && (
        <li><a href={project.data.links.demo} target="_blank" rel="noopener">Demo</a></li>
      )}
    </ul>
  )}

  <div class="prose">
    <Content />
  </div>
</Base>
